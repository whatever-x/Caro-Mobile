platform :ios do
  lane :dev_match do
    match(
      type: "development",
      app_identifier: ["com.whatever.caro.dev"],
      readonly: true
    )
  end

  lane :qa_match do
    match(
      type: "development",
      app_identifier: ["com.whatever.caro.qa"],
      readonly: true
    )

    match(
      type: "appstore",
      app_identifier: ["com.whatever.caro.qa"],
      readonly: true
    )
  end

  lane :prod_match do
    match(
      type: "development",
      app_identifier: ["com.whatever.caro"],
      readonly: true
    )

    match(
      type: "appstore",
      app_identifier: ["com.whatever.caro"],
      readonly: true
    )
  end

  # QA 배포: 서명 프로파일 fetch → 아카이브 → TestFlight 업로드
  lane :qa_deploy do
    qa_match

    gym(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "Caro-QaRelease",
      configuration: "QaRelease",
      export_method: "app-store",
      output_directory: "build/ios"
    )

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      # APP_STORE_CONNECT_API_KEY_FILE 은 repo 루트 기준 경로
      key_filepath: File.expand_path(ENV.fetch("APP_STORE_CONNECT_API_KEY_FILE"), File.expand_path("..", __dir__))
    )

    pilot(
      api_key: api_key,
      app_identifier: "com.whatever.caro.qa",
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  # QA 배포: QA Release APK 빌드 → Firebase App Distribution 업로드
  lane :qa_deploy do
    gradle(
      task: "assemble",
      flavor: "Qa",
      build_type: "Release"
    )

    firebase_app_distribution(
      app: "1:1031334193504:android:d09321f78a2b81feb39605",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      groups: ENV["FIREBASE_TESTER_GROUPS"],
      android_artifact_type: "APK"
    )
  end
end
